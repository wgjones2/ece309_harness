{
    "version": "0.2.0",
    "configurations": [
        {
            // F5. Requires gdb inside WSL:  sudo apt install gdb
            "name": "Debug harness (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/harness",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            // The harness reads from stdin, so it needs a real terminal.
            // The Debug Console cannot accept typed input.
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build harness"
        }
    ]
}
